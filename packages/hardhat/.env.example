# ====================================================================
# scaffold-hbar-ats-dvp — Hardhat Package Environment Variables
# ====================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ====================================================================

# ---- Deployer / Operator ----
# Private key of the account that deploys DvPSettlement and runs scripts.
# Must be an ECDSA key with HBAR balance on Hedera Testnet.
DEPLOYER_PRIVATE_KEY=0x...

# ---- ATS Administrator ----
# Private key of the ATS token admin account.
# Used by setup scripts to grant KYC/eligibility to participants.
ATS_ADMIN_PRIVATE_KEY=0x...

# ---- Demo Participants ----
# Seller: holds the ATS asset, creates the DvP offer.
SELLER_PRIVATE_KEY=0x...

# Buyer: holds the HTS payment token, accepts the DvP offer.
BUYER_PRIVATE_KEY=0x...

# ---- Deployed Contract Addresses ----
# Populated by setup scripts after provisioning.
# EVM address (0x...) of the ATS asset token.
ATS_TOKEN_ADDRESS=

# EVM address (0x...) of the HTS payment token.
PAYMENT_TOKEN_ADDRESS=

# EVM address (0x...) of the deployed DvPSettlement contract.
DVP_SETTLEMENT_ADDRESS=

# ---- Network Configuration ----
# Override the default Hedera Testnet RPC URL if needed.
# Default: https://testnet.hashio.io/api
HEDERA_RPC_URL=

# ---- ATS Factory / Resolver (for setup scripts) ----
# Hedera Account IDs for the ATS factory and BLR resolver (testnet reference deployments).
# Obtained from the ATS documentation or your own ATS deployment.
ATS_FACTORY_ADDRESS=
ATS_RESOLVER_ADDRESS=
