# ====================================================================
# scaffold-hbar-ats-dvp — Next.js Package Environment Variables
# ====================================================================
# Copy this file to .env and fill in your values.
# NEXT_PUBLIC_ variables are exposed in the browser bundle.
# NEVER commit .env to version control.
# ====================================================================

# ---- DvP Settlement Contract ----
# EVM address (0x...) of the deployed DvPSettlement contract on Hedera Testnet.
# Leave empty to run in Local Mode (see local mode banner in the UI).
NEXT_PUBLIC_DVP_SETTLEMENT_ADDRESS=

# ---- Token Addresses ----
# EVM address (0x...) of the ATS asset token (the permissioned security token).
NEXT_PUBLIC_ATS_TOKEN_ADDRESS=

# EVM address (0x...) of the HTS payment token.
NEXT_PUBLIC_PAYMENT_TOKEN_ADDRESS=

# ---- WalletConnect / RainbowKit ----
# Get a Project ID at https://cloud.walletconnect.com
# Required for HashPack, Blade, and other WalletConnect-based wallets.
# MetaMask works without this.
NEXT_PUBLIC_WC_PROJECT_ID=

# ---- Pyth Network Price Oracle ----
# HBAR/USD price feed ID (default). Full catalog: https://pyth.network/developers/price-feed-ids
NEXT_PUBLIC_PYTH_FEED_ID=0xd2c5cef8b13e832a63ea0eed95aed2c7cff08a22a60a79bce07c5c4a0ed3dd85
# Pyth API key — required for hermes.pyth.network (obtain at https://pythdata.app/signup)
NEXT_PUBLIC_PYTH_API_KEY=